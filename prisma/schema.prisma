generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int      @id @default(autoincrement())
  sku         String   @unique
  name        String
  brand       String
  category    String   // 'antenna', 'router', 'switch', 'accessory', 'cable', 'poe'
  description String   @default("")

  // Technical specs
  frequency     String?  // '5 GHz', '2.4 GHz', '2.4/5 GHz'
  gainDbi       Float?   @map("gain_dbi")
  maxDistanceKm Float?   @map("max_distance_km")
  throughput    String?
  poeType       String?  @map("poe_type")
  linkType      String?  @map("link_type")   // 'PtP', 'PtMP', 'Backhaul', 'CPE'
  useCase       String?  @map("use_case")    // 'enlace', 'cliente', 'infraestructura'

  // Stock & pricing
  quantity  Int     @default(0)
  minStock  Int     @default(5) @map("min_stock")
  costPrice Float   @default(0) @map("cost_price")
  sellPrice Float   @default(0) @map("sell_price")
  currency  String  @default("USD")

  // Metadata
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  movements StockMovement[]

  @@map("products")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  type      String   // 'in', 'out', 'adjust'
  quantity  Int
  notes     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

model ChatMessage {
  id        Int      @id @default(autoincrement())
  sessionId String   @default("default") @map("session_id")
  role      String   // 'user', 'assistant', 'system'
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("chat_messages")
}
